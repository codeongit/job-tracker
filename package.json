{
  "name": "job-tracker",
  "version": "0.8.5",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "service": "node scripts/service-control.mjs",
    "boss": "node scripts/boss-control.mjs",
    "test": "node --test test/*.test.mjs collector/boss/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node --test test/browser-regression.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm test && pnpm check && pnpm format:check && pnpm test:browser",
    "doctor": "node scripts/doctor.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "3.9.6"
  },
  "packageManager": "pnpm@11.19.0"
}
